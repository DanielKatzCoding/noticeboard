# Development Dockerfile - simpler, with hot-reload and dev tools
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/root/.local/bin/:$PATH"

WORKDIR /app

# Install system dependencies (build tools, curl for uv, postgres client)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       curl \
       libpq-dev \
       postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install uv for dependency management
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies (includes dev dependencies)
RUN uv sync --locked

# Copy application code (will be mounted as volume, but included for standalone use)
COPY manage.py ./
COPY core/ ./core/
COPY noticeboard/ ./noticeboard/

# Create staticfiles and media directories
RUN mkdir -p /app/staticfiles /app/media

ENV PATH="/app/.venv/bin:$PATH" \
    STATIC_ROOT=/app/staticfiles \
    MEDIA_ROOT=/app/media \
    DEBUG=True

EXPOSE 8000

# Use Django development server with auto-reload
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
