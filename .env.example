# .env.example - Template for environment files
# Copy this file to .env.db, .env.dev, and .env.prod and customize each one

# Django Settings
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-value
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
POSTGRES_DB=noticeboard_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=django_password

# Django Database Settings (used by settings.py)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=noticeboard_db
DB_USER=django_user
DB_PASSWORD=django_password
DB_HOST=db
DB_PORT=5432

# Notes:
# 1. Database credentials (POSTGRES_*) should match across all environment files
# 2. SECRET_KEY should be unique for security (generate a new one for production)
# 3. DEBUG should be False in production environments
# 4. ALLOWED_HOSTS should include your domain names in production
# 5. DB_HOST should be 'db' when using docker-compose (matches service name)
